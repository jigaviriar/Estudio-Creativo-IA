# --- Acceso a AWS (usa SOLO una de estas dos opciones) ---
AWS_BEARER_TOKEN_BEDROCK=MY_SECRET_HERE
AWS_REGION=us-east-2
# AWS_PROFILE=nombre-de-tu-perfil

# --- Modelos en Amazon Bedrock ---
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Cifrado local de imágenes y contenido (Fernet) ---
APP_ENCRYPTION_KEY=MY_SECRET_HERE

# --- Modo demo (sin llamadas reales a AWS) ---
DEMO_MODE=false
